# Notion integration
NOTION_API_KEY=secret_xxx
NOTION_DATABASE_ID=xxx

# Local LLMs via Ollama
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen3:8b
CATEGORIZE_MODEL=qwen3:4b
ANALYZE_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_IDLE_UNLOAD_SECONDS=300
ENABLE_WHISPER_FALLBACK=true
WHISPER_MODEL=small
NOTION_INCLUDE_SOURCE_CONTENT=false

API_SECRET=notionlearner-local-secret

LEARNING_CATEGORIES=Information Theory,Convex Optimization,Linear Algebra,Probability & Statistics,Machine Learning,Deep Learning,Computer Vision,NLP / LLMs,Reinforcement Learning,Signal Processing,Algorithms,Other
